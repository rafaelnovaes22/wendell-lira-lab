{
  "name": "wendell-lira-lab",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "node -e \"fs.rmSync('.test-build',{recursive:true,force:true})\" && tsc -p tsconfig.test.json && node --test .test-build/tests/*.test.js",
    "typecheck": "tsc --noEmit",
    "verify": "npm test && npm run typecheck && npm run lint && npm run build"
  },
  "dependencies": {
    "lucide-react": "^0.544.0",
    "next": "16.3.4",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.28.0",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.13"
  }
}
